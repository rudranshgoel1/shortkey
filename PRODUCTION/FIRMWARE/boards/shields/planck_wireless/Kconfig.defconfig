if SHIELD_PLANCK_WIRELESS

# Name must be less than 16 characters long!
config ZMK_KEYBOARD_NAME
    default "Planck"

# --- 0.91" SSD1306 OLED (I2C) ---
if ZMK_DISPLAY

config I2C
    default y

config SSD1306
    default y

endif # ZMK_DISPLAY

if LVGL

config LV_Z_VDB_SIZE
    default 64

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

endif # LVGL

# --- SK6812 per-key RGB (WS2812-compatible, driven over SPI) ---
if ZMK_RGB_UNDERGLOW

config SPI
    default y

config WS2812_STRIP
    default y

endif # ZMK_RGB_UNDERGLOW

endif # SHIELD_PLANCK_WIRELESS
